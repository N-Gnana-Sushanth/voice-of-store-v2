# Voice of Store Backend - Environment Configuration Example
# Copy this file to .env and replace placeholder values with your secure secrets.

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
DEBUG=false

# Database Configuration
# For PostgreSQL (Production / Render):
# DATABASE_URL=postgresql+psycopg://username:password@hostname:5432/voice_of_store
# For Local Development / Testing:
DATABASE_URL=sqlite:///./voice_of_store.db

# Authentication & Security
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-frontend.onrender.com

# Operational Limits
MAX_REQUEST_BODY_BYTES=2097152
RATE_LIMIT_PER_MINUTE=120

# Initial Superadmin Provisioning (optional for first-time seed command)
INITIAL_ADMIN_EMAIL=admin@voiceofstore.internal
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_SECURE_PASSWORD_123!
